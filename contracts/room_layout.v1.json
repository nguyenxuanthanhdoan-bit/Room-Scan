{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoomLayoutV1",
  "description": "Standardized output contract for RoomScan AI spatial reconstruction engine",
  "type": "object",
  "required": ["version", "room_id", "dimensions", "boundary_polygon", "walls"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "room_id": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "default": "meters"
    },
    "dimensions": {
      "type": "object",
      "required": ["width", "length", "height", "area", "volume"],
      "properties": {
        "width": { "type": "number", "description": "Maximum width in meters" },
        "length": { "type": "number", "description": "Maximum length in meters" },
        "height": { "type": "number", "description": "Ceiling height in meters" },
        "area": { "type": "number", "description": "Usable floor area in square meters" },
        "volume": { "type": "number", "description": "Room volume in cubic meters" }
      }
    },
    "boundary_polygon": {
      "type": "array",
      "description": "Ordered 2D polygon vertices representing the snapped floor boundary [(x1, z1), (x2, z2), ...]",
      "items": {
        "type": "array",
        "items": { "type": "number" },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["wall_id", "length", "start_point", "end_point"],
        "properties": {
          "wall_id": { "type": "string" },
          "length": { "type": "number" },
          "start_point": { "type": "array", "items": { "type": "number" } },
          "end_point": { "type": "array", "items": { "type": "number" } },
          "openings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["door", "window"] },
                "width": { "type": "number" },
                "height": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "export_paths": {
      "type": "object",
      "properties": {
        "obj": { "type": "string" },
        "dxf": { "type": "string" },
        "glb": { "type": "string" }
      }
    }
  }
}
